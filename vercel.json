{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/send-push", "destination": "/api/index" },
    { "source": "/api/push", "destination": "/api/index" },
    { "source": "/api/webhook", "destination": "/api/index" },
    { "source": "/api/payment", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}