// RASTREIO-GLOBAL: GPS continuo em qualquer tela do app.
// Inicia sozinho quando existe sessao ativa e para no logout.
// Salvamento no banco limitado a 1 vez a cada 30 segundos.
import { supabase } from './supabase';

let watchId: number | null = null;
let ultimaSalva = 0;
let usuarioAtivo: string | null = null;
let fantasma = false; // GHOST-GUARD
let ghostTimer: any = null; // GHOST-GUARD

const salvarCoordenada = (lat: number, lon: number) => {
  if (!usuarioAtivo) return;
  if (fantasma) return; // GHOST-GUARD
  if (Date.now() - ultimaSalva < 30000) return;
  ultimaSalva = Date.now();
  (supabase as any)
    .from('users')
    .update({ lat, lon })
    .eq('user_id', usuarioAtivo)
    .then(({ error }: any) => {
      if (error) console.error('RASTREIO-GLOBAL falhou', error);
    });
};

const comecar = (uid: string) => {
  if (watchId !== null) return;
  if (typeof navigator === 'undefined' || !navigator.geolocation) return;
  usuarioAtivo = uid;
  const checarFantasma = () => { (supabase as any).from('users').select('ghost_mode').eq('user_id', uid).maybeSingle().then(({ data }: any) => { fantasma = !!data?.ghost_mode; }); }; // GHOST-GUARD
  checarFantasma();
  ghostTimer = setInterval(checarFantasma, 60000); // GHOST-GUARD
  watchId = navigator.geolocation.watchPosition(
    (pos) => salvarCoordenada(pos.coords.latitude, pos.coords.longitude),
    () => {},
    { enableHighAccuracy: true, maximumAge: 15000, timeout: 25000 }
  );
};

const parar = () => {
  if (watchId !== null && typeof navigator !== 'undefined' && navigator.geolocation) {
    navigator.geolocation.clearWatch(watchId);
  }
  watchId = null;
  usuarioAtivo = null;
  if (ghostTimer) clearInterval(ghostTimer); // GHOST-GUARD
};

supabase.auth.getSession().then(({ data }: any) => {
  const uid = data?.session?.user?.id;
  if (uid) comecar(uid);
});

supabase.auth.onAuthStateChange((_evento: string, sessao: any) => {
  if (sessao?.user?.id) comecar(sessao.user.id);
  else parar();
});
